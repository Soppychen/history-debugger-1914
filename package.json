{
  "name": "history-debugger-1914-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "validate:data": "node scripts/validate-game-data.mjs",
    "validate:ladder": "node scripts/validate-ladder-system.mjs",
    "validate:visuals": "node scripts/validate-visual-assets.mjs",
    "art:check-missing": "node scripts/check-missing-art.mjs",
    "art:finalize-missing": "node scripts/finalize-missing-art.mjs",
    "art:watch": "node scripts/watch-art-and-publish.mjs --publish",
    "test": "npm run validate:data && npm run validate:ladder && npm run validate:visuals && npm run build",
    "android:sync": "npm run build && npx cap sync android",
    "android:copy": "npm run build && npx cap copy android",
    "android:open": "npx cap open android",
    "android:run": "npm run build && npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
